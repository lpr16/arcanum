<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arcanum.Core\Arcanum.Core.fsproj" />
    <ProjectReference Include="..\Arcanum.Hashing\Arcanum.Hashing.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DiffieHellman.fs" />
    <Compile Include="Rsa.fs" />
    <Compile Include="Ecdsa.fs" />
    <Compile Include="Rfc6979.fs" />
    <Compile Include="EcdsaDer.fs" />
    <Compile Include="HashToCurve.fs" />
  </ItemGroup>

</Project>
